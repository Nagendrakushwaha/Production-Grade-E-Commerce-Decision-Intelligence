# E-Commerce Decision Intelligence Platform Environment Configuration

# Path to the raw dataset directory (CSV files: orders.csv, products.csv, etc.)
DATA_DIR=./Dataset

# Path to Parquet storage directory for high-speed queries
PARQUET_DIR=./data/parquet

# Path to persistent models directory
MODEL_DIR=./models

# Path to precomputed analytics cache
CACHE_DIR=./data/processed

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Analytical Engine Configuration
DUCKDB_MEMORY_LIMIT=8GB
DUCKDB_THREADS=6

# Random Seed for Reproducibility
RANDOM_STATE=42
